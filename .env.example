# .env.example
# Copy this to .env and fill in your real keys.
# NEVER commit .env to git.

DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com

# News API (choose one — set NEWS_API_PROVIDER accordingly)
NEWSAPI_KEY=your_newsapi_key_here
SERPER_API_KEY=your_serper_key_here
NEWS_API_PROVIDER=newsapi   # or "serper"

# Image API (choose one — set IMAGE_API_PROVIDER accordingly)
# Serper.dev Google Images (uses SERPER_API_KEY above; recommended default)
UNSPLASH_ACCESS_KEY=your_unsplash_key_here
PEXELS_API_KEY=your_pexels_key_here
IMAGE_API_PROVIDER=serper   # "serper" (recommended), "unsplash", "pexels", or "mock"

#LLM_judge keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here