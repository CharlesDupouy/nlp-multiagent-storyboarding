# .gitignore

# Environment & secrets
.env
*.local.yaml

# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Outputs (ignore all local runs except committed reference storyboards)
outputs/storyboards/*
!outputs/storyboards/storyboard_baseline_20261030_234731_1896cb67.*
!outputs/storyboards/storyboard_20261031_124354_0ec406a8.*
outputs/*.tmp

# Data (may contain personal info)
data/user_histories/*.json
!data/user_histories/example.json

# Editor
.vscode/
.idea/
*.swp
