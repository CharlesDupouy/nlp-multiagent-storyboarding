# .gitignore

# Environment & secrets
.env
*.local.yaml

# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Outputs (allow storyboards to be visible in editor)
outputs/*.tmp
!outputs/storyboards/

# Data (may contain personal info)
data/user_histories/*.json
!data/user_histories/example.json

# Editor
.vscode/
.idea/
*.swp
