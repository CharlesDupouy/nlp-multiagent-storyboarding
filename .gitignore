# .gitignore

# Environment & secrets
.env
*.local.yaml

# Virtual environment
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Outputs (ignore all local generated runs by default)
outputs/*
!outputs/.gitkeep
outputs/*.tmp
outputs/*.mp4
*.mp4

# Data (may contain personal info)
data/user_histories/*.json
!data/user_histories/example.json

# Editor
.vscode/
.idea/
*.swp
